// Copy to Config/Signing.xcconfig (gitignored) to build with your Apple Developer team.
// Nothing in the code needs to change. Never commit the real file.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = YOURTEAMID
OTHER_CODE_SIGN_FLAGS = --timestamp

// App Group shared by the app and the widget. On macOS a group that starts with the Team ID
// needs no provisioning profile.
HEADROOM_APP_GROUP = $(DEVELOPMENT_TEAM).io.github.garoknows.headroom
HEADROOM_APP_ENTITLEMENTS = App/Headroom-Signed.entitlements
HEADROOM_WIDGET_ENTITLEMENTS = Widgets/HeadroomWidgets-Signed.entitlements

// Notarization rejects the debugger entitlement (get-task-allow); never add it to signed builds.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
