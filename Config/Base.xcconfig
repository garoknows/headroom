// Shared build settings. Signing defaults to ad hoc ("Sign to Run Locally"), which needs no
// Apple account. To sign with your Apple Developer team, copy Signing.example.xcconfig to
// Signing.xcconfig (gitignored, never committed) and fill in your Team ID.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none

// Unsigned builds have no App Group, so the widget shows "install the signed release".
HEADROOM_APP_GROUP =
HEADROOM_APP_ENTITLEMENTS = App/Headroom.entitlements
HEADROOM_WIDGET_ENTITLEMENTS = Widgets/HeadroomWidgets.entitlements

#include? "Signing.xcconfig"
